{
  "name": "site3w-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@heroicons/vue": "^2.2.0",
    "@iconify/vue": "^4.1.2",
    "@tanstack/vue-query": "^5.51.0",
    "@tanstack/vue-table": "^8.17.0",
    "@vueuse/core": "^10.11.0",
    "@vueuse/motion": "^2.2.3",
    "date-fns": "^3.6.0",
    "fuse.js": "^7.0.0",
    "maska": "^3.0.0",
    "pinia": "^2.1.7",
    "sweetalert2": "^11.12.0",
    "vee-validate": "^4.13.1",
    "vue": "^3.4.38",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.26.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.1.4"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  }
}
