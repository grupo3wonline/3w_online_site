# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Template de variáveis de ambiente — 3W Online
#
# 1. Copie este arquivo para .env
# 2. Preencha os valores reais
# 3. NUNCA commite o .env com valores reais
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Ambiente ────────────────────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_NAME=3W Online
VITE_APP_VERSION=1.0.0

# ─── URLs do Site ────────────────────────────────────────────────────────────
VITE_SITE_URL=https://www.seudominio.com.br
VITE_API_PROXY=/api.php

# Base path do Vite (use '/' para deploy na raiz, '/subdir/' para subdiretórios)
VITE_BASE=/

# ─── Empresa — Contato ───────────────────────────────────────────────────────
VITE_SITE_EMAIL=contato@seudominio.com.br
VITE_PRIVACY_EMAIL=privacidade@seudominio.com.br
VITE_WHATSAPP_NUMBER=5511999999999
VITE_PHONE=(11) 99999-9999
VITE_PHONE_INTL=+55-11-99999-9999

# ─── Empresa — Redes Sociais ─────────────────────────────────────────────────
VITE_FACEBOOK_URL=https://www.facebook.com/suapagina
VITE_INSTAGRAM_URL=https://www.instagram.com/suapagina
VITE_LINKEDIN_URL=https://www.linkedin.com/company/suaempresa

# ─── SEO & Open Graph ────────────────────────────────────────────────────────
VITE_OG_IMAGE=/og-image.jpg

# ─── Geolocalização (Schema.org / GEO meta tags) ─────────────────────────────
VITE_GEO_REGION=BR-SP
VITE_GEO_CITY=São Paulo
VITE_GEO_STATE=São Paulo
VITE_GEO_LAT=-23.5505
VITE_GEO_LNG=-46.6333

# ─── Google reCAPTCHA v3 — CHAVE PÚBLICA (site key) ──────────────────────────
# Obtenha em: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# ─── Cloudflare Turnstile — CHAVE PÚBLICA (site key) ─────────────────────────
# Obtenha em: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

# ─── Google Analytics 4 e Tag Manager ───────────────────────────────────────
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# ───────────────────────────────────────────────────────────────────────────────
# ⚠️  CHAVES SECRETAS DO BACKEND — NÃO VÃO NO .env
#
# Configure via SetEnv no .htaccess (produção) ou variável de ambiente do servidor:
#
#   SetEnv API_HMAC_SECRET     <string hexadecimal de 64 chars>
#   SetEnv API_RECAPTCHA_SECRET <chave secreta do Google>
#   SetEnv API_TURNSTILE_SECRET <chave secreta do Cloudflare>
#
# Para gerar o HMAC secret:
#   php -r "echo bin2hex(random_bytes(32));"
# ───────────────────────────────────────────────────────────────────────────────

# ─── Endpoints de APIs Externas (backend only — nunca no bundle JS) ──────────
# Configure via SetEnv no .htaccess para sobrescrever em produção.
API_EXT_IPV4=https://api4.ipify.org
API_EXT_IPV6=https://api6.ipify.org
API_EXT_GEOIP=https://ipwho.is
API_EXT_GEOIP_FALLBACK=https://ipapi.co/json/
API_EXT_DNS=https://dns.google/resolve
API_EXT_RDAP=https://rdap.org/domain
API_EXT_CEP_BRASILAPI=https://brasilapi.com.br/api/cep/v2
API_EXT_CEP_VIACEP=https://viacep.com.br/ws
API_EXT_CNPJ=https://brasilapi.com.br/api/cnpj/v1
