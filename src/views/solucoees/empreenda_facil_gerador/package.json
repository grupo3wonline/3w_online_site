{
  "name": "empreenda_facil_gerador",
  "homepage": "/empreenda_facil_gerador/",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.cjs,.mjs --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@casl/ability": "^6.7.2",
    "@casl/vue": "^2.2.2",
    "@iconify/vue": "^4.1.2",
    "@tanstack/vue-table": "^8.20.5",
    "@vueuse/core": "^11.1.0",
    "@vueuse/motion": "^2.2.6",
    "date-fns": "^3.6.0",
    "fuse.js": "^7.0.0",
    "maska": "^3.0.4",
    "pinia": "^2.2.4",
    "vee-validate": "^4.13.2",
    "vue": "^3.5.11",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "sweetalert2": "^11.14.1",
    "zod": "^3.23.8",
    "@vee-validate/zod": "^4.13.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
