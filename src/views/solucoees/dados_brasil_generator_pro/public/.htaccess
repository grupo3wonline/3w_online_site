# ==========================================================================
# Dados Brasil Generator Pro — Apache config (Hostgator / hospedagem compartilhada)
# Local: public_html/dados_brasil_generator_pro/.htaccess
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

# --------------------------------------------------------------------------
# SPA fallback (Vue Router history mode) sob o subdiretório
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dados_brasil_generator_pro/

  # Não reescrever arquivos/pastas existentes (assets, sitemap, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html (roteamento no cliente)
  RewriteRule ^ index.html [L]
</IfModule>

# --------------------------------------------------------------------------
# Cabeçalhos de segurança
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS (só sobre HTTPS) — força HTTPS por 1 ano
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Content Security Policy — permite GTM/GA, Google Fonts, Iconify API e imagens data:
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com https://www.google-analytics.com https://region1.google-analytics.com https://*.ingest.sentry.io; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"

  # Não cachear o HTML (garante que atualizações cheguem)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Compressão GZIP
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# --------------------------------------------------------------------------
# Cache dos assets (hash no nome garante invalidação segura)
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --------------------------------------------------------------------------
# Bloqueia acesso a arquivos sensíveis
# --------------------------------------------------------------------------
<FilesMatch "(^\.env|\.env\..*|package\.json|package-lock\.json|\.git.*|tsconfig.*|vite\.config.*)$">
  Require all denied
</FilesMatch>

# Página de erro personalizada (SPA cuida do 404 no cliente)
ErrorDocument 404 /dados_brasil_generator_pro/index.html
