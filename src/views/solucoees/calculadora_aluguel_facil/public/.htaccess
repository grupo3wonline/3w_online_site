# ===================================================================
# Calculadora Aluguel Fácil — configuração Apache (HostGator)
# Aplicação SPA (Vue 3) servida no subdiretório /calculadora_aluguel_facil/
# ===================================================================

# ---------- SPA fallback ----------
# Redireciona todas as rotas não-arquivo para o index.html do SPA.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /calculadora_aluguel_facil/

  # Não reescreve arquivos ou diretórios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto cai no index.html (roteamento no cliente)
  RewriteRule ^ index.html [L]
</IfModule>

# ---------- Cabeçalhos de segurança ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set X-XSS-Protection "1; mode=block"
  # HSTS (ativar somente com HTTPS configurado no domínio)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Remove header que expõe versão do servidor
  Header unset X-Powered-By
</IfModule>

# ---------- Compressão (Gzip) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---------- Cache do navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets com hash no nome: cache longo e imutável
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML nunca deve ser cacheado (garante deploy imediato)
  <FilesMatch "\.(html)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Bloqueio de acesso a arquivos sensíveis ----------
<FilesMatch "(^\.|\.(env|json|lock|md|map)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
# Permite explicitamente o manifest.json usado pela PWA
<Files "manifest.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# ---------- Páginas de erro personalizadas ----------
ErrorDocument 404 /calculadora_aluguel_facil/index.html
