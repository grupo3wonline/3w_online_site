# Variáveis de ambiente (opcionais) — copie para .env e preencha se necessário.
# Nenhuma é obrigatória para o funcionamento do app.

# DSN do Sentry para monitoramento de erros em produção.
# Se vazio, o Sentry não é inicializado (sem overhead).
VITE_SENTRY_DSN=

# IDs de analytics (já embutidos no index.html; aqui apenas para referência).
VITE_GA4_ID=G-J06THXX0MW
VITE_GTM_ID=GTM-WVMJV7G6
