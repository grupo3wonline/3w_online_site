        if (!response.ok) {

button:active:not(:disabled) {          throw new Error(`Erro na requisição: ${response.status}`);

  transform: translateY(0);        }

}

</style>        const data = await response.json();


        if (data.content) {
          thumbnail_data.value = data.content;
          // Scroll to result
          await nextTick();
          const element = document.querySelector(
            ".border-t.border-gray-200.bg-gray-50"
          );
          if (element) {
            element.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        } else {
          error.value =
            data.message ||
            "Não foi possível obter a thumbnail. Verifique se a URL está correta.";
        }
      } catch (e) {
        console.error("Erro ao obter thumbnail:", e);
        error.value = getErrorMessage(e.message);
      }

      loading.value = false;
    };

    const isValidYouTubeUrl = (url) => {
      const youtubeRegex =
        /^(https?:\/\/)?(www\.)?(youtube\.com\/(watch\?v=|embed\/|v\/)|youtu\.be\/)[\w-]+(&\S*)?$/;
      return youtubeRegex.test(url);
    };

    const getErrorMessage = (message) => {
      if (message.includes("network") || message.includes("fetch")) {
        return "Erro de conexão. Verifique sua internet e tente novamente.";
      }
      if (message.includes("404") || message.includes("not found")) {
        return "Vídeo não encontrado. Verifique se a URL está correta e se o vídeo está público.";
      }
      if (message.includes("400")) {
        return "URL inválida. Por favor, cole uma URL válida do YouTube.";
      }
      return message || "Ocorreu um erro inesperado. Tente novamente.";
    };

    const sanitizeFilename = (title) => {
      return title
        .replace(/[^a-zA-Z0-9\s\-_]/g, "")
        .replace(/\s+/g, "_")
        .substring(0, 50);
    };

    const copyImageUrl = async () => {
      if (!thumbnail_data.value?.thumbnail_url) return;

      try {
        await navigator.clipboard.writeText(thumbnail_data.value.thumbnail_url);
        copied.value = true;
        setTimeout(() => {
          copied.value = false;
        }, 2000);
      } catch (err) {
        console.error("Erro ao copiar:", err);
        // Fallback for older browsers
        const textArea = document.createElement("textarea");
        textArea.value = thumbnail_data.value.thumbnail_url;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        document.body.removeChild(textArea);
        copied.value = true;
        setTimeout(() => {
          copied.value = false;
        }, 2000);
      }
    };

    const clearError = () => {
      error.value = null;
    };

    const resetTool = () => {
      youtube_url.value = "";
      thumbnail_data.value = null;
      error.value = null;
      imageLoaded.value = false;
      imageError.value = false;
      copied.value = false;
    };

    return {
      youtube_url,
      loading,
      error,
      thumbnail_data,
      imageLoaded,
      imageError,
      copied,
      getThumbnail,
      sanitizeFilename,
      copyImageUrl,
      clearError,
      resetTool,
    };
  },
  mounted() {
    // Focus on input when page loads
    const input = document.getElementById("youtube_url");
    if (input) {
      input.focus();
    }

    // Add keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey && e.key === "Enter") {
        this.getThumbnail();
      }
    });
  },
};
</script>

<style scoped>
/* Custom animations */
@keyframes pulse-red {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
  }
}

.animate-pulse-red {
  animation: pulse-red 2s infinite;
}

/* Loading spinner animation */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

/* Smooth transitions */
.transition-all {
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 200ms;
}

/* Focus styles */
input:focus {
  transform: translateY(-1px);
}

/* Button hover effects */
button:hover:not(:disabled) {
  transform: translateY(-2px);
}

button:active:not(:disabled) {
  transform: translateY(0);
}
</style>
