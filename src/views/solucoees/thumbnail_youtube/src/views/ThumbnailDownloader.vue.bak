<style scoped>

.transition-all {        const response = await fetch(

  transition-property: all;          "https://3wsys-back-hotwyl.vercel.app/consultas/capa_youtube",

  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);          {

  transition-duration: 200ms;            method: "POST",

}            headers: {

              "Content-Type": "application/json",

