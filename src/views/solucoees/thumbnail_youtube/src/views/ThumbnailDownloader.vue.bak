<script>                    thumbnail_data.title

import { ref, nextTick } from 'vue'                  )}_thumbnail.jpg`"

import LoadingSpinner from '../components/LoadingSpinner.vue'                  class="flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transform hover:-translate-y-1 transition-all duration-200 shadow-lg hover:shadow-xl"

                >

export default {                  <svg

  name: 'ThumbnailDownloader',                    class="w-5 h-5 mr-2"

  components: {                    fill="none"

    LoadingSpinner                    stroke="currentColor"

  },                    viewBox="0 0 24 24"

  setup() {                  >

    const youtube_url = ref('')                    <path

    const loading = ref(false)                      stroke-linecap="round"

    const error = ref(null)                      stroke-linejoin="round"

    const thumbnail_data = ref(null)                      stroke-width="2"

    const imageLoaded = ref(false)                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"

    const imageError = ref(false)                    />

    const copied = ref(false)                  </svg>

                  Baixar Thumbnail

    const getThumbnail = async () => {                </a>

      if (!youtube_url.value.trim()) return

                <button

      loading.value = true                  @click="copyImageUrl"

      error.value = null                  class="flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transform hover:-translate-y-1 transition-all duration-200 shadow-lg hover:shadow-xl"

      thumbnail_data.value = null                >

      imageLoaded.value = false                  <svg

      imageError.value = false                    class="w-5 h-5 mr-2"

                    fill="none"

      try {                    stroke="currentColor"

        if (!isValidYouTubeUrl(youtube_url.value)) {                    viewBox="0 0 24 24"

          throw new Error('Por favor, insira uma URL válida do YouTube')                  >

        }                    <path

                      stroke-linecap="round"

        const response = await fetch('https://3wsys-back-hotwyl.vercel.app/consultas/capa_youtube', {                      stroke-linejoin="round"

          method: 'POST',                      stroke-width="2"

          headers: {                      d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"

            'Content-Type': 'application/json'                    />

          },                  </svg>

          body: JSON.stringify({                  {{ copied ? "Copiado!" : "Copiar URL" }}

            video_url: youtube_url.value.trim()                </button>

          })              </div>

        })

              <!-- Image Info -->

        if (!response.ok) {              <div class="bg-gray-100 rounded-xl p-4">

          throw new Error(`Erro na requisição: ${response.status}`)                <h4 class="font-semibold text-gray-800 mb-2">

        }                  Informações da Imagem

                </h4>

        const data = await response.json()                <div

                  class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-600"

        if (data.content) {                >

          thumbnail_data.value = data.content                  <div><span class="font-medium">Formato:</span> JPG</div>

          await nextTick()                  <div>

          const element = document.querySelector('.border-t.border-gray-200.bg-gray-50')                    <span class="font-medium">Qualidade:</span> Alta definição

          if (element) {                  </div>

            element.scrollIntoView({ behavior: 'smooth', block: 'start' })                </div>

          }              </div>

        } else {            </div>

          error.value = data.message || 'Não foi possível obter a thumbnail. Verifique se a URL está correta.'

        }            <!-- Try Another -->

      } catch (e) {            <div class="mt-8 text-center">

        console.error('Erro ao obter thumbnail:', e)              <button

        error.value = getErrorMessage(e.message)                @click="resetTool"

      }                class="inline-flex items-center px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700 transition-colors"

              >

      loading.value = false                <svg

    }                  class="w-4 h-4 mr-2"

                  fill="none"

    const isValidYouTubeUrl = (url) => {                  stroke="currentColor"

      const youtubeRegex = /^(https?:\/\/)?(www\.)?(youtube\.com\/(watch\?v=|embed\/|v\/)|youtu\.be\/)[\w-]+(&\S*)?$/                  viewBox="0 0 24 24"

      return youtubeRegex.test(url)                >

    }                  <path

                    stroke-linecap="round"

    const getErrorMessage = (message) => {                    stroke-linejoin="round"

      if (message.includes('network') || message.includes('fetch')) {                    stroke-width="2"

        return 'Erro de conexão. Verifique sua internet e tente novamente.'                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"

      }                  />

      if (message.includes('404') || message.includes('not found')) {                </svg>

        return 'Vídeo não encontrado. Verifique se a URL está correta e se o vídeo está público.'                Baixar Outra Thumbnail

      }              </button>

      if (message.includes('400')) {            </div>

