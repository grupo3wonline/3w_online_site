<template>
  <div
    class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Download de Thumbnail do YouTube
        </h1>
        <p class="text-lg text-gray-600">Cole a URL do v�deo abaixo</p>
      </div>
      <div class="bg-white rounded-2xl shadow-xl p-6">
        <form @submit.prevent="getThumbnail">
          <input
            v-model="youtube_url"
            type="url"
            required
            placeholder="https://www.youtube.com/watch?v=..."
            class="w-full px-4 py-3 border rounded-xl"
          />
          <button
            type="submit"
            :disabled="loading"
            class="w-full mt-4 px-6 py-3 bg-red-600 text-white rounded-xl"
          >
            Obter Thumbnail
          </button>
        </form>
        <div v-if="error" class="mt-4 p-4 bg-red-50 rounded-xl">
          <p class="text-red-700">{{ error }}</p>
        </div>
        <div v-if="thumbnail_data" class="mt-6">
          <h3 class="text-xl font-bold mb-2">{{ thumbnail_data.title }}</h3>
          <img
            :src="thumbnail_data.thumbnail_url"
            :alt="thumbnail_data.title"
            class="w-full rounded-xl mb-4"
          />
          <a
            :href="thumbnail_data.thumbnail_url"
            download
            class="block text-center px-6 py-3 bg-green-600 text-white rounded-xl"
            >Baixar</a
          >
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { ref } from "vue";
export default {
  name: "ThumbnailDownloader",
  setup() {
    const youtube_url = ref("");
    const loading = ref(false);
    const error = ref(null);
    const thumbnail_data = ref(null);
    const getThumbnail = async () => {
      loading.value = true;
      error.value = null;
      try {
        const response = await fetch(
          "https://3wsys-back-hotwyl.vercel.app/consultas/capa_youtube",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ video_url: youtube_url.value }),
          }
        );
        const data = await response.json();
        if (data.content) thumbnail_data.value = data.content;
        else error.value = "Erro ao obter thumbnail";
      } catch (e) {
        error.value = "Erro: " + e.message;
      }
      loading.value = false;
    };
    return { youtube_url, loading, error, thumbnail_data, getThumbnail };
  },
};
</script>
