{
  "name": "calculadora_preco",
  "private": true,
  "version": "2.0.0",
  "homepage": "/calculadora_preco/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx,.js --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@sentry/vue": "^8.42.0",
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^11.3.0",
    "@vueuse/motion": "^2.2.6",
    "apexcharts": "^5.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "maska": "^3.0.4",
    "pinia": "^2.2.6",
    "reka-ui": "^1.0.0-alpha.10",
    "sweetalert2": "^11.14.5",
    "tailwind-merge": "^2.5.5",
    "vee-validate": "^4.14.7",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
