{
  "name": "calculadora_programadores",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "/calculadora_programadores/",
  "description": "Calculadora de orçamentos para programadores e freelancers. Desenvolvido pelo Grupo 3w Online.",
  "author": "hotwyl | willfrombrasil",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "type-check": "vue-tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@iconify-json/fa6-brands": "^1.2.5",
    "@iconify-json/lucide": "^1.2.28",
    "@iconify/vue": "^4.3.0",
    "@vueuse/motion": "^2.2.6",
    "pinia": "^2.2.6",
    "sweetalert2": "^11.14.5",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,vue,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
