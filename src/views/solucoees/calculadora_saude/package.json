{
  "name": "calculadora_saude",
  "private": true,
  "version": "1.0.0",
  "homepage": "/calculadora_saude/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/generate-sitemap.cjs",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.cjs --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@vee-validate/zod": "^4.14.7",
    "@vueuse/core": "^11.3.0",
    "@vueuse/motion": "^2.2.6",
    "apexcharts": "^5.10.0",
    "jspdf": "^3.0.1",
    "maska": "^3.0.4",
    "pinia": "^2.2.6",
    "sweetalert2": "^11.14.5",
    "vee-validate": "^4.14.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
