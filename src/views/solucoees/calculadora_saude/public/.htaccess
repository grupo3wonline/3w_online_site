# ==========================================================================
# Calculadora de Saúde — Grupo 3W Online
# Configuração Apache para hospedagem compartilhada (Hostgator)
# Aplicação Vue 3 (SPA) servida em subdiretório /calculadora_saude/
# ==========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /calculadora_saude/

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Não reescreve arquivos ou diretórios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback SPA: qualquer rota desconhecida volta ao index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --------------------------------------------------------------------------
# Cabeçalhos de segurança (proteção contra ataques comuns)
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Impede que o site seja embutido em iframes (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Impede sniffing de MIME type
  Header always set X-Content-Type-Options "nosniff"
  # Controla o envio do Referer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Restringe APIs sensíveis do navegador
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # Força HTTPS por 1 ano (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Content Security Policy — libera apenas origens necessárias (Google Fonts, GA/GTM, Iconify)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'"

  # Remove header que expõe a versão do servidor
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------------------------
# Compressão GZIP (performance)
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Cache do navegador (performance)
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets com hash no nome podem ter cache longo
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML sempre revalidado (para pegar deploys novos)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --------------------------------------------------------------------------
# Bloqueia acesso a arquivos sensíveis
# --------------------------------------------------------------------------
<FilesMatch "(^\.|package(-lock)?\.json$|\.(env|log|map|ts|config\.js)$)">
  Require all denied
</FilesMatch>

# Páginas de erro personalizadas (SPA cuida do 404 no cliente)
ErrorDocument 404 /calculadora_saude/index.html
