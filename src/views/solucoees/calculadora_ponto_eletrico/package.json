{
  "name": "calculadora_ponto_eletrico",
  "version": "1.0.0",
  "private": true,
  "homepage": "/calculadora_ponto_eletrico/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
