{
  "name": "calculadora_social_midia",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "homepage": "/calculadora_social_midia/",
  "description": "Calculadora profissional e gratuita de redes sociais - Vue 3 + Vite + TypeScript.",
  "author": "willfrombrasil | hotwyl",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx,.js",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,json,css}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@casl/ability": "^6.7.2",
    "@casl/vue": "^2.2.2",
    "@iconify/vue": "^4.3.0",
    "@sentry/vue": "^8.47.0",
    "@vueuse/core": "^11.3.0",
    "@vueuse/motion": "^2.2.6",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.0.0",
    "maska": "^3.0.4",
    "pinia": "^2.3.0",
    "sweetalert2": "^11.15.3",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.37.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
