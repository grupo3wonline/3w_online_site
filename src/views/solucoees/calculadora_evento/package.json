{
  "name": "calculadora_evento",
  "version": "2.1.0",
  "private": true,
  "homepage": "/calculadora_evento/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,vue,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/vue": "^8.55.2",
    "@vueuse/core": "^11.3.0",
    "js-cookie": "^3.0.5",
    "maska": "^3.2.1",
    "pinia": "^2.3.1",
    "sweetalert2": "^11.16.1",
    "vue": "^3.4.38",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/js-cookie": "^3.0.6",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.6"
  }
}
