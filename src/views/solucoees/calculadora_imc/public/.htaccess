# Configuração para hospedagem compartilhada (Apache / HostGator)
# App Vue 3 (SPA) servida no subdiretório /calculadora_imc/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /calculadora_imc/

  # Não reescrever arquivos ou diretórios existentes (assets, imagens, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todas as demais rotas caem no index.html (history mode do Vue Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão (performance)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets com hash (imutáveis)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  # Não cachear o HTML de entrada
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cabeçalhos de segurança básicos
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
