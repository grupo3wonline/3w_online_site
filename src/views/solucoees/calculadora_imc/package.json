{
  "name": "calculadora_imc",
  "version": "0.1.0",
  "private": true,
  "homepage": "/calculadora_imc/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{vue,ts}\" \"e2e/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen:images": "node scripts/gen-images.mjs"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "@sentry/vue": "^10.75.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^11.1.0",
    "@vueuse/motion": "^2.2.6",
    "apexcharts": "^7.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1",
    "maska": "^3.2.1",
    "pinia": "^2.2.4",
    "sweetalert2": "^11.14.1",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.1.6"
  }
