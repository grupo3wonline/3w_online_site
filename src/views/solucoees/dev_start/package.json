{
  "name": "dev_start",
  "version": "1.0.0",
  "private": true,
  "homepage": "/dev_start/",
  "type": "module",
  "description": "DevStart Academy - Plataforma educacional gamificada para aprender lógica de programação, algoritmos, PHP e desenvolvimento web. Desenvolvido pelo Grupo 3W Online.",
  "author": "willfrombrasil | hotwyl",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/vue": "^2.2.2",
    "@iconify/vue": "^4.3.0",
    "@sentry/vue": "^8.47.0",
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^11.3.0",
    "@vueuse/motion": "^2.2.6",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.0.0",
    "maska": "^3.0.4",
    "mime": "^4.0.6",
    "pinia": "^2.3.0",
    "sweetalert2": "^11.14.5",
    "vee-validate": "^4.14.7",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
