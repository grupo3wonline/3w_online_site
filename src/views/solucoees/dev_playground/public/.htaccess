# =====================================================================
# DevPlayground — .htaccess para HostGator (Apache)
# SPA Vue Router (history mode) sob o subdiretório /dev_playground/
# + cabeçalhos de segurança, compressão e cache.
# =====================================================================

# ---------------------------------------------------------------------
# 1) Roteamento SPA: redireciona tudo que não for arquivo/pasta real
#    para o index.html, preservando o base path /dev_playground/.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dev_playground/

  # Não reescrever o endpoint PHP da API
  RewriteRule ^api/ - [L]

  # Se não for um arquivo ou diretório existente, entrega o index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /dev_playground/index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# 2) Cabeçalhos de segurança
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Content Security Policy — permite recursos usados (Google Analytics/GTM, fontes, Iconify)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Remove header que expõe tecnologia
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
# 3) Compressão (gzip)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 4) Cache de assets estáticos (arquivos com hash no nome)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------
# 5) Proteção de arquivos sensíveis
# ---------------------------------------------------------------------
<FilesMatch "(^\.env|\.env\..*|\.gitignore|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>

# Impede listagem de diretórios
Options -Indexes
