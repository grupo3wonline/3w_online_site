{
  "name": "analisador_texto",
  "version": "3.0.0",
  "private": true,
  "homepage": "/analisador_texto/",
  "type": "module",
  "description": "Analisador de Texto — ferramenta web gratuita para análise e comparação de textos, 100% local no navegador. Desenvolvido pelo Grupo 3W Online.",
  "author": "HOTWYL | WILLFROMBRASIL — Grupo 3W Online",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.mjs --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts,.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@sentry/vue": "^8.30.0",
    "@vueuse/core": "^11.1.0",
    "@vueuse/motion": "^2.2.6",
    "fuse.js": "^7.0.0",
    "pinia": "^2.2.2",
    "sweetalert2": "^11.14.1",
    "vue": "^3.5.6",
    "vue-i18n": "^10.0.1",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "terser": "^5.33.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
