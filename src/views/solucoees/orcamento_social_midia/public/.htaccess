# =============================================================
# Orçamento Social Mídia — Deploy em hospedagem compartilhada
# HostGator (Apache) sob o subdiretório /orcamento_social_midia/
# Este arquivo é copiado de public/ para dist/ no build.
# =============================================================

# Segurança: impede listagem de diretórios
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /orcamento_social_midia/

  # Força HTTPS (recomendado em produção)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fallback SPA: se o arquivo/pasta não existir, entrega o index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ------- Cabeçalhos de segurança -------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Content Security Policy (ajuste os domínios conforme necessário)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.ingest.sentry.io; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'"
  # Remove header que expõe tecnologia
  Header unset X-Powered-By
</IfModule>

# ------- Compressão GZIP -------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ------- Cache de assets estáticos -------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML não deve ser cacheado agressivamente (SPA)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ------- Páginas de erro (fallback do servidor para a SPA) -------
ErrorDocument 404 /orcamento_social_midia/index.html
ErrorDocument 403 /orcamento_social_midia/index.html

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "(^\.env|\.map$|package\.json|package-lock\.json)">
  Require all denied
</FilesMatch>
