{
  "name": "calculadora_indicadores_financeiros",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "/calculadora_indicadores_financeiros/",
  "description": "Calculadora de Indicadores Financeiros — análise da saúde financeira de empresas (EBITDA, ROE, ROA, P/L, EV/EBITDA e mais).",
  "author": "HOTWYL | WILLFROMBRASIL",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "@vueuse/motion": "^2.2.6",
    "apexcharts": "^5.10.0",
    "date-fns": "^4.1.0",
    "maska": "^3.0.4",
    "pinia": "^2.2.6",
    "sweetalert2": "^11.14.5",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@sentry/vue": "^8.38.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
