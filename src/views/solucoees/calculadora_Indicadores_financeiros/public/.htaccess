# ============================================================
# Calculadora de Indicadores Financeiros
# Desenvolvido por HOTWYL | WILLFROMBRASIL
# HostGator (Apache) — SPA Vue em subdiretório
# /calculadora_indicadores_financeiros/
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /calculadora_indicadores_financeiros/

  # ---- Bloquear bots maliciosos ----
  RewriteCond %{HTTP_USER_AGENT} (havij|sqlmap|nikto|nmap|openvas|w3af|acunetix) [NC]
  RewriteRule .* - [F,L]

  # ---- Proteção contra injeção via query string ----
  RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} proc/self/environ [OR]
  RewriteCond %{QUERY_STRING} base64_(en|de)code[^(]*\([^)]*\) [OR]
  RewriteCond %{QUERY_STRING} UNION([^A]*A)+LL([^S]*S)+ELECT [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./\.\./) [OR]
  RewriteCond %{QUERY_STRING} etc/passwd
  RewriteRule .* - [F,L]

  # Não reescrever arquivos e diretórios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto cai no index.html (history mode do Vue Router)
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Cabeçalhos de segurança ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.ingest.sentry.io; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'"
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ---- Compressão GZIP ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2
</IfModule>

# ---- Cache de assets estáticos ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- Bloquear arquivos sensíveis ----
<FilesMatch "(^\.env|\.env\..*|^\.htaccess|^\.htpasswd|^\.git|\.bak$|\.log$|\.sql$)">
  Require all denied
</FilesMatch>

# ---- Charset e MIME ----
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Desabilita listagem de diretórios
Options -Indexes

# Limitar tamanho de requisição (10MB)
LimitRequestBody 10485760
