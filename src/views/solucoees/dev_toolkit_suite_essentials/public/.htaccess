# =========================================================================
# Dev Toolkit Suite Essentials - Configuração Apache (HostGator)
# SPA fallback + cabeçalhos de segurança + compressão + cache
# =========================================================================

# --- SPA fallback: redireciona rotas do Vue Router para o index.html ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dev_toolkit_suite_essentials/

  # Não reescreve arquivos ou diretórios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html (histórico HTML5)
  RewriteRule ^ index.html [L]
</IfModule>

# --- Cabeçalhos de segurança ---
<IfModule mod_headers.c>
  # Impede que o site seja embutido em iframes de terceiros (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Impede MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Política de referência
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Restringe APIs sensíveis do navegador
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # HSTS (força HTTPS por 1 ano) - ative após confirmar que o HTTPS funciona
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy — permite GTM/GA, Google Fonts e imagens; bloqueia o resto
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://*.ingest.sentry.io; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'"

  # Remove header que expõe a versão do servidor
  Header unset X-Powered-By
</IfModule>

# --- Compressão GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Cache de assets estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
  # HTML nunca em cache longo (para atualizações do SPA)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Bloqueia acesso a arquivos sensíveis ---
<FilesMatch "(^\.|package\.json|package-lock\.json|\.map$)">
  Require all denied
</FilesMatch>

# --- Páginas de erro personalizadas (SPA) ---
ErrorDocument 404 /dev_toolkit_suite_essentials/index.html
