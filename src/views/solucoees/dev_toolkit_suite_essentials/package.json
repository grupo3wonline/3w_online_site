  "version": "1.0.0",
  "homepage": "/dev_toolkit_suite_essentials/",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
