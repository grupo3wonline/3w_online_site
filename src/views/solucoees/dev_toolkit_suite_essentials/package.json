    "@iconify/vue": "^4.3.0",
    "@sentry/vue": "^8.47.0",
    "@vueuse/core": "^12.5.0",
    "@vueuse/motion": "^2.2.6",
    "date-fns": "^4.1.0",
    "file-type": "^22.1.1",
    "fuse.js": "^7.0.0",
    "maska": "^3.0.4",
    "marked": "^15.0.6",
    "mime": "^4.0.6",
    "papaparse": "^5.5.3",
    "pinia": "^2.3.1",
    "radix-vue": "^1.9.13",
    "sweetalert2": "^11.15.10",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
